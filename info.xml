<?xml version="1.0"?>
<extension key="one.jonathandhn.wallet" type="module">
  <file>civi_wallet</file>
  <name>CiviWallet</name>
  <description>Generate Apple Wallet and Google Wallet passes and QR codes for CiviCRM event participants, memberships, and donors.</description>
  <license>AGPL-3.0-or-later</license>
  <maintainer>
    <author>Jonathan Dahan</author>
    <email>jonathan@dhn.one</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://lab.civicrm.org/extensions/wallet</url>
    <url desc="Documentation">https://lab.civicrm.org/extensions/wallet/-/blob/main/README.md</url>
    <url desc="Issue Tracker">https://lab.civicrm.org/extensions/wallet/-/issues</url>
    <url desc="Website">https://www.jonathan.paris/en</url>
    <url desc="Support">https://www.jonathan.paris/en/contact</url>
    <url desc="Licensing">https://civicrm.org/extensions/LICENSE.txt</url>
  </urls>
  <releaseDate>2026-10-10</releaseDate>
  <version>1.6</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>6.16</ver>
  </compatibility>
  <smarty_compatibility>
    <ver>3</ver>
    <ver>4</ver>
    <ver>5</ver>
  </smarty_compatibility>
  <php_compatibility>
    <ver>8.4</ver>
    <ver>8.5</ver>
  </php_compatibility>
  <comments>Wallet passes and QR codes for event participants, memberships, and donors.</comments>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\Wallet\" path="Civi/Wallet"/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/Wallet</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@1.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
  </mixins>
  <upgrader>CiviMix\Schema\CiviWallet\AutomaticUpgrader</upgrader>
</extension>
