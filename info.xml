<?xml version="1.0"?>
<extension key="org.soshomophobie.wallet" type="module">
  <file>civi_wallet</file>
  <name>CiviWallet</name>
  <description>Generate Apple Wallet and Google Wallet tickets for CiviCRM Events</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>SOS homophobie</author>
    <email>sos@sos-homophobie.org</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/soshomophobie/org.soshomophobie.wallet</url>
    <url desc="Documentation">https://github.com/soshomophobie/org.soshomophobie.wallet</url>
    <url desc="Support">https://github.com/soshomophobie/org.soshomophobie.wallet/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2025-11-27</releaseDate>
  <version>1.0</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments>Initial release</comments>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\Wallet\" path="Civi/Wallet"/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/Wallet</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
  <upgrader>CiviMix\Schema\CiviWallet\AutomaticUpgrader</upgrader>
</extension>
