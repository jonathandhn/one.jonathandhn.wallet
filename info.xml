<?xml version="1.0"?>
<extension key="one.jonathandhn.wallet" type="module">
  <file>civi_wallet</file>
  <name>CiviWallet</name>
  <description>Generate Apple Wallet and Google Wallet tickets for CiviCRM Events</description>
  <license>AGPL-3.0-or-later</license>
  <maintainer>
    <author>Jonathan Dahan</author>
    <email>jonathan@dhn.one</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/jonathandhn/one.jonathandhn.wallet</url>
    <url desc="Documentation">https://github.com/jonathandhn/one.jonathandhn.wallet</url>
    <url desc="Support">https://github.com/jonathandhn/one.jonathandhn.wallet/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-06-29</releaseDate>
  <version>1.5</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>6.16</ver>
  </compatibility>
  <smarty_compatibility>
    <ver>3</ver>
    <ver>4</ver>
    <ver>5</ver>
  </smarty_compatibility>
  <php_compatibility>
    <ver>8.2</ver>
    <ver>8.3</ver>
    <ver>8.4</ver>
    <ver>8.5</ver>
  </php_compatibility>
  <comments>Initial release</comments>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\Wallet\" path="Civi/Wallet"/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <civix>
    <namespace>CRM/Wallet</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@1.0.0</mixin>
    <mixin>scan-classes@1.0.0</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
  </mixins>
  <upgrader>CiviMix\Schema\CiviWallet\AutomaticUpgrader</upgrader>
</extension>
